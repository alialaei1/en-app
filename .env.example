# Django
SECRET_KEY=django-insecure-dev-change-me-please
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost
# Production example:
# DEBUG=false
# ALLOWED_HOSTS=mimivo.ir,www.mimivo.ir
# CSRF_TRUSTED_ORIGINS=https://mimivo.ir,https://www.mimivo.ir

# App
APP_NAME=Mimivo
APP_ENV=development

# Whisper models
# Faster ← tiny.en | base.en | small.en | medium.en | large-v3 | turbo → slower/heavier
# For English lessons prefer *.en (turbo/large are multilingual-only)
WHISPER_MODEL=small.en
# Speaking STT model (optional). If empty, uses WHISPER_MODEL.
# SPEAK_WHISPER_MODEL=base.en
# WHISPER_INSECURE_DOWNLOAD=1
# HOME=/www/wwwroot/en-app
# XDG_CACHE_HOME=/www/wwwroot/en-app/.cache

# Server
HOST=127.0.0.1
PORT=8000
