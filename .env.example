# Django
SECRET_KEY=django-insecure-dev-change-me-please
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost
# Production example:
# DEBUG=false
# ALLOWED_HOSTS=mimivo.ir,www.mimivo.ir
# CSRF_TRUSTED_ORIGINS=https://mimivo.ir,https://www.mimivo.ir

# App
APP_NAME=Mimivo
APP_ENV=development

# Whisper model download (only if VPS SSL verify fails)
# WHISPER_INSECURE_DOWNLOAD=1
# HOME=/www/wwwroot/en-app
# XDG_CACHE_HOME=/www/wwwroot/en-app/.cache


# Server
HOST=127.0.0.1
PORT=8000
